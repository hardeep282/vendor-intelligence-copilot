# Copy this file to .env and fill in your own values. .env is git-ignored.
# NEVER paste real keys into chat, issues, commits or screenshots.
#
# Key policy (ADR-004):
#   - This file holds DEV keys only: a separate Anthropic key and LangSmith key named "...-dev",
#     with a monthly spend limit set in the Anthropic Console.
#   - PROD keys are different keys. They live only in AWS SSM Parameter Store under
#     /vendor-copilot/prod/ as SecureString, and the server reads them at start-up.
#   - gitleaks runs in pre-commit and in CI to catch any key that slips into a commit.

APP_ENV=dev

# LLM provider (needed from Day 3)
ANTHROPIC_API_KEY=

# LangSmith tracing (needed from Day 3)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vendor-copilot-dev

# Global daily LLM spend cap in USD (enforced by the input gate)
DAILY_SPEND_CAP_USD=5

# Minimum number of SKUs behind any figure shown to a user
MIN_AGGREGATION_K=5

# AWS (used in prod only; locally the app never calls AWS)
AWS_REGION=ap-south-1
SSM_PREFIX=/vendor-copilot/prod

# Day 8 step 7: orchestrator checkpoint store. Leave unset for local dev and tests -- that's a
# local SQLite file, no setup needed. Set this to switch to Postgres, e.g. after
# `docker compose -f infra/local/compose.yaml up -d`:
# CHECKPOINT_DATABASE_URL=postgresql://copilot:copilot-local-dev-only@localhost:5432/copilot_checkpoints
CHECKPOINT_DATABASE_URL=
