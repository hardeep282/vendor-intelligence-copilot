# Python
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Secrets and local config
.env
*.pem

# LICENCE RULE: purchased-data derivatives never enter Git.
# The snapshot is rebuilt locally by scripts/build_snapshot.py; only its manifest is tracked.
data/snapshot/*.parquet
data/snapshot/*.duckdb
data/private/
# Chroma vector store: rebuilt locally by scripts/build_rag_index.py from knowledge/, same
# never-commit-derived-data rule as the snapshot above.
data/chroma/
*.xlsx
*.csv
# Guardian audit log (Day 7 step 3): a local, append-only record of every decision -- same
# never-commit-local-runtime-data rule as the entries above, never *.jsonl in general.
data/audit/*.jsonl
# Input gate's daily spend tracker (Day 7 step 6): local runtime state, same rule.
data/spend/*.json

# Tooling
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
