# Python
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Secrets and local config
.env
*.pem

# LICENCE RULE: purchased-data derivatives never enter Git.
# The snapshot is rebuilt locally by scripts/build_snapshot.py; only its manifest is tracked.
data/snapshot/*.parquet
data/snapshot/*.duckdb
data/private/
# Chroma vector store: rebuilt locally by scripts/build_rag_index.py from knowledge/, same
# never-commit-derived-data rule as the snapshot above.
data/chroma/
*.xlsx
*.csv
# Guardian audit log (Day 7 step 3): a local, append-only record of every decision -- same
# never-commit-local-runtime-data rule as the entries above, never *.jsonl in general.
data/audit/*.jsonl
# Input gate's daily spend tracker (Day 7 step 6) and the per-user daily budget tracker
# (Day 8, A2 §1.6): local runtime state, same rule.
data/spend/*.json
# Auth store (Day 8 step 4): hashed invite codes and API keys -- never commit, even hashed.
data/auth/*.json
# Local SQLite checkpoint DB (Day 6 step 6 / Day 8 step 7's fallback when no
# CHECKPOINT_DATABASE_URL is set): local runtime state, same rule.
data/orchestrator_checkpoints.sqlite

# Tooling
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
